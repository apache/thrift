# Rendered by build/windows/build-chocolatey-package.ps1.

$ErrorActionPreference = 'Stop'

$packageArgs = @{
    packageName    = 'thrift'
    fileType       = 'exe'

    # The installer published with the Apache Thrift release. The archive keeps
    # every release; downloads.apache.org only carries the current one, so a
    # package naming it would stop installing at the next release.
    url64bit       = '__INSTALLER_URL__'
    checksum64     = '__INSTALLER_SHA256__'
    checksumType64 = 'sha256'

    # Inno Setup. /ALLUSERS because Chocolatey installs machine wide, and the
    # modifypath task is what puts thrift.exe on PATH.
    silentArgs     = '/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP- /ALLUSERS /TASKS="modifypath"'
    validExitCodes = @(0)
}

Install-ChocolateyPackage @packageArgs
