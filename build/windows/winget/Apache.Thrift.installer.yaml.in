# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.12.0.schema.json

PackageIdentifier: Apache.Thrift
PackageVersion: __VERSION__
MinimumOSVersion: 10.0.0.0
InstallerType: inno
Scope: user
InstallModes:
  - interactive
  - silent
  - silentWithProgress
UpgradeBehavior: install
# Inno Setup registers its uninstaller under "<AppId>_is1". The AppId is fixed
# in build/windows/installer/thrift.iss and must never change.
ProductCode: '{064E0C5D-29EE-47DD-BB5E-172FE25FE936}_is1'
ReleaseDate: __RELEASE_DATE__
# The compiler links the shared runtime, so it needs the Visual C++
# redistributable, which the ASF cannot ship. WinGet installs this first.
Dependencies:
  PackageDependencies:
    - PackageIdentifier: Microsoft.VCRedist.2015+.x64
Installers:
  - Architecture: x64
    InstallerUrl: __INSTALLER_URL__
    # Quoted: a checksum that happened to be all digits would otherwise be
    # read as a YAML number and rejected by the schema as not a string.
    InstallerSha256: '__INSTALLER_SHA256__'
ManifestType: installer
ManifestVersion: 1.12.0
