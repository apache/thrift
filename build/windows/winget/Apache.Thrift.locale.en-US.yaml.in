# yaml-language-server: $schema=https://aka.ms/winget-manifest.defaultLocale.1.12.0.schema.json

PackageIdentifier: Apache.Thrift
PackageVersion: __VERSION__
PackageLocale: en-US
Publisher: Apache Software Foundation
PublisherUrl: https://www.apache.org/
PublisherSupportUrl: https://thrift.apache.org/docs/
PrivacyUrl: https://privacy.apache.org/policies/privacy-policy-public.html
Author: Apache Thrift Developers
PackageName: Apache Thrift Compiler
PackageUrl: https://thrift.apache.org/
License: Apache-2.0
LicenseUrl: https://www.apache.org/licenses/LICENSE-2.0
Copyright: Copyright (c) The Apache Software Foundation
CopyrightUrl: https://www.apache.org/licenses/LICENSE-2.0
ShortDescription: The Apache Thrift IDL compiler
Description: |-
  Apache Thrift is a software framework for scalable cross-language services
  development. It combines a software stack with a code generation engine to
  build services that work efficiently between a large number of languages.

  This package contains the Thrift compiler, which turns a .thrift interface
  definition into client and server code. The runtime libraries are distributed
  separately, through each language's own package manager.
Moniker: thrift
Tags:
  - apache
  - codegen
  - compiler
  - idl
  - rpc
  - serialization
  - thrift
ReleaseNotesUrl: https://github.com/apache/thrift/blob/master/CHANGES.md
Documentations:
  - DocumentLabel: Documentation
    DocumentUrl: https://thrift.apache.org/docs/
  - DocumentLabel: Tutorial
    DocumentUrl: https://thrift.apache.org/tutorial/
ManifestType: defaultLocale
ManifestVersion: 1.12.0
